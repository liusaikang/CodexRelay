# Generate .env with npm run init:env. Do not commit the generated file.
CODEX_MCP_TOKEN=
# Required by Docker; choose a strong value before exposing the console.
CODEX_CONSOLE_USERNAME=admin
CODEX_CONSOLE_PASSWORD=
# Production Node startup requires these paths; Docker Compose maps them to its persistent volume.
CODEX_DATA_DIR=
CODEX_INVOCATION_LOG_DIR=
CODEX_HOME=
CODEX_WORKSPACE=
CODEX_BIND_HOST=127.0.0.1
CODEX_PUBLIC_HOST=
CODEX_PUBLIC_ORIGIN=
# Docker Compose requires a real project path on the host.
CODEX_WORKSPACE_HOST=
# Optional: API key authentication, otherwise authenticate a dedicated Codex home.
CODEX_API_KEY=
# Empty values use Codex defaults; task requests cannot override these settings.
CODEX_MODEL=
CODEX_MODEL_REASONING_EFFORT=
CODEX_MCP_URL=http://127.0.0.1:8787
# Docker host port; keep the default loopback publishing unless using a trusted proxy.
CODEX_MCP_PORT=8787
# Optional outbound proxy for a native process; leave empty when not needed.
HTTPS_PROXY=
HTTP_PROXY=
NO_PROXY=127.0.0.1,localhost,::1
