# Generate .env with npm run init:env. Do not commit the generated file.
CODEX_MCP_TOKEN=
# Optional: API key authentication, otherwise authenticate a dedicated Codex home.
CODEX_API_KEY=
# Empty values use Codex defaults; requests may override these settings.
CODEX_MODEL=
CODEX_MODEL_REASONING_EFFORT=
CODEX_MCP_URL=http://127.0.0.1:8787
# Docker host port; keep the default loopback publishing unless using a trusted proxy.
CODEX_MCP_PORT=8787
# Optional outbound proxy for a native process; leave empty when not needed.
HTTPS_PROXY=
HTTP_PROXY=
NO_PROXY=127.0.0.1,localhost,::1
