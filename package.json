{
  "name": "codex-task-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Configurable full-access Codex task service with durable sessions and bounded concurrency",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run start:dev",
    "init:env": "node scripts/init-env.mjs",
    "start:dev": "node --env-file=.env dist/main.js --config config/development.yaml",
    "start:prod": "node --env-file=.env dist/main.js --config config/production.yaml",
    "start:env": "npm run start:dev",
    "check:dev": "node --env-file=.env dist/main.js --config config/development.yaml --check",
    "check:prod": "node --env-file=.env dist/main.js --config config/production.yaml --check",
    "config:check": "npm run check:dev",
    "example:diagnose": "node --env-file=.env examples/backend-client.mjs",
    "release:check": "node scripts/check-release.mjs",
    "demo": "npm run build && node scripts/demo-server.mjs",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && vitest run",
    "smoke": "node scripts/smoke.mjs",
    "smoke:demo": "node scripts/smoke.mjs --demo",
    "smoke:browser": "node scripts/browser-smoke.mjs && node scripts/session-smoke.mjs && node scripts/queue-smoke.mjs",
    "smoke:container": "node scripts/container-smoke.mjs",
    "docs:screenshots": "node scripts/queue-smoke.mjs --screenshots",
    "verify": "npm run check && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@openai/codex-sdk": "^0.155.1",
    "express": "^5.2.1",
    "lucide": "^1.47.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
